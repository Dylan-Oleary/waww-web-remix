{
  "private": true,
  "sideEffects": false,
  "scripts": {
    "-- BOOT SCRIPTS --": "",
    "build": "yarn remix:build",
    "build:clean": "rm -rf ./.cache ./build",
    "dev": "remix dev",
    "remix:build": "remix build",
    "start": "remix-serve build",
    "-- CODE QUALITY SCRIPTS --": "",
    "check:code": "concurrently -n ESLint,Prettier -c green,yellow \"yarn lint\" \"yarn prettier\"",
    "lint": "eslint  && echo \"\n\nLint Complete - S'all Good Man!\n\n\"",
    "prettier": "prettier --check \"./app/*\"",
    "prettier:fix": "prettier --write \"./app/*\"",
    "typecheck": "tsc -b",
    "-- GIT HOOK SCRIPTS --": "",
    "husky:commit-msg": "npx --no -- commitlint --edit ${1}",
    "husky:pre-commit": "yarn check:code",
    "husky:pre-push": "yarn remix build",
    "prepare": "husky install",
    "-- TEST SCRIPTS --": "",
    "test": "jest --verbose",
    "test:coverage": "yarn test --collectCoverage",
    "test:watch": "yarn test --watch"
  },
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/server": "^11.10.0",
    "@mantine/core": "^5.9.5",
    "@mantine/hooks": "^5.9.5",
    "@mantine/remix": "^5.9.5",
    "@remix-run/node": "^1.12.0",
    "@remix-run/react": "^1.12.0",
    "@remix-run/serve": "^1.12.0",
    "@remix-run/vercel": "^1.12.0",
    "@vercel/node": "^2.9.0",
    "dayjs": "^1.11.7",
    "isbot": "^3.6.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^3.20.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.3.0",
    "@commitlint/config-conventional": "^17.3.0",
    "@remix-run/dev": "^1.12.0",
    "@remix-run/eslint-config": "^1.12.0",
    "@theonlydevsever/eslint-config": "^1.0.2",
    "@theonlydevsever/prettier": "^1.0.0",
    "@types/jest": "^29.2.4",
    "@types/react": "^18.0.25",
    "@types/react-dom": "^18.0.8",
    "concurrently": "^7.6.0",
    "eslint": "^8.27.0",
    "eslint-config-prettier": "^8.5.0",
    "husky": "^8.0.0",
    "jest": "^29.3.1",
    "jest-environment-jsdom": "^29.3.1",
    "jest-fetch-mock": "^3.0.3",
    "prettier": "^2.8.1",
    "ts-jest": "^29.0.3",
    "typescript": "^4.8.4"
  },
  "engines": {
    "node": ">=14"
  }
}
